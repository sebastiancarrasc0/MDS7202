# Copien este archivo como `.env` y cambien los valores que dicen `cambiar`.
# `.env` no se versiona: contiene llaves. Escriban los valores sin comillas.

# Llave de OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=cambiar-por-su-llave-de-openrouter

# Llave de Tavily (https://app.tavily.com).
TAVILY_API_KEY=cambiar-por-su-llave-de-tavily

# Modelos de OpenRouter. Los gratuitos terminan en `:free`.
MODELO_CHAT=google/gemma-4-31b-it:free
MODELO_EMBEDDINGS=nvidia/nemotron-3.5-embed-1b:free
